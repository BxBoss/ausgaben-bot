# Anthropic API-Key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Google Sheets: ID aus der Sheet-URL
# https://docs.google.com/spreadsheets/d/<HIER_STEHT_DIE_ID>/edit
GOOGLE_SHEET_ID=

# Name des Tabellenblatts (Reiter), in das geschrieben wird
GOOGLE_SHEET_NAME=Ausgaben

# Pfad zum Service-Account JSON-Key (siehe SETUP.md)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
